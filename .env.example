# Client-safe Supabase configuration
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only equivalents
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallback while migrating existing deployments
SUPABASE_SERVICE_ROLE_KEY=

# Platform owner bootstrap — server secret, never expose to the browser
# Production platform owner account (existing Supabase user):
# ADMIN_EMAIL=peacechloe96@gmail.com
ADMIN_EMAIL=

# Public site URL (required for OAuth redirects / metadata)
PUBLIC_APP_URL=https://aether-cold-vault-v100.vercel.app

# MCP OAuth 2.1 (Claude / ChatGPT / Grok connectors)
# Client ID is required on connector forms. Secret is optional when using PKCE.
MCP_OAUTH_CLIENT_ID=aether-vault-mcp
MCP_OAUTH_CLIENT_SECRET=
# Optional dedicated signing secret for auth codes (falls back to SUPABASE_SECRET_KEY)
MCP_OAUTH_SIGNING_SECRET=
